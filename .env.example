# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
SUPABASE_SECRET_KEY=sb_secret_your-server-only-key

# Initial Supabase Auth admin
SUPABASE_ADMIN_EMAIL=admin@example.com
SUPABASE_ADMIN_USERNAME=admin
SUPABASE_ADMIN_PASSWORD=replace-with-a-strong-password

# Google reCAPTCHA v2 (Checkbox)
RECAPTCHA_SITE_KEY=your-recaptcha-site-key
RECAPTCHA_SECRET_KEY=your-server-only-recaptcha-secret-key
RECAPTCHA_ENABLED=true

# Session Configuration
SESSION_SECRET=your-super-secret-session-key-here-change-this-in-production

# Email Configuration (for password reset)
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-app-specific-password

# Server Configuration
PORT=3000
