<!DOCTYPE html>
<html lang="en">
<%- include('partials/public-head', { pageTitle: title, pageDescription: 'Connect with Barangay Malimba. Access community announcements, request appointments, and stay informed through our resident portal.' }) %>
<body class="landing-page">
    <% const registrationEnabled = typeof allowUserRegistration === 'undefined' || allowUserRegistration !== false; %>
    <% const announcements = typeof homeAnnouncements !== 'undefined' && Array.isArray(homeAnnouncements) ? homeAnnouncements : []; %>
    <% const signedIn = typeof isAuthenticated !== 'undefined' && isAuthenticated === true; %>
    <% const dashboardUrl = typeof admin !== 'undefined' && admin ? '/admin/dashboard' : '/users/dashboard'; %>
    <%- include('partials/public-header', { currentPage: 'home' }) %>

    <main id="main-content" tabindex="-1">
        <section class="hero-section" aria-labelledby="hero-title">
            <div class="page-container hero-grid">
                <div class="hero-copy">
                    <div class="eyebrow hero-eyebrow"><span class="eyebrow-dot" aria-hidden="true"></span> YOUR BARANGAY, CONNECTED</div>
                    <h1 id="hero-title">A stronger community.<br><span>Closer to you.</span></h1>
                    <p class="hero-description"><%= typeof siteDescription !== 'undefined' && siteDescription ? siteDescription : 'Access barangay services, stay informed, and connect with the people who care for our community. All in one place.' %></p>
                    <div class="hero-actions">
                        <% if (signedIn) { %>
                            <a href="<%= dashboardUrl %>" class="button button-primary">Open your portal <i class="fa-solid fa-arrow-right" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><use href="#icon-arrow-right"></use></svg></i></a>
                        <% } else if (registrationEnabled) { %>
                            <a href="/users/register" class="button button-primary" data-open-register>Get started <i class="fa-solid fa-arrow-right" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><use href="#icon-arrow-right"></use></svg></i></a>
                        <% } else { %>
                            <a href="/users/login" class="button button-primary" data-open-login>Sign in to the portal <i class="fa-solid fa-arrow-right" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><use href="#icon-arrow-right"></use></svg></i></a>
                        <% } %>
                        <a href="#services" class="button button-outline">Explore our services</a>
                    </div>
                    <div class="hero-note"><i class="fa-solid fa-shield-heart" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><use href="#icon-shield-heart"></use></svg></i><span>Built for our residents. Dedicated to our community.</span></div>
                </div>
                <div class="hero-visual">
                    <div class="photo-accent" aria-hidden="true"></div>
                    <figure class="hero-photo">
                        <img src="/images/b.jpg" alt="Barangay Malimba community members gathered together at a local event" width="2048" height="1536" fetchpriority="high">
                        <figcaption><span class="photo-caption-label">TOGETHER FOR MALIMBA</span><span>Our people. Our pride. Our community.</span></figcaption>
                    </figure>
                    <div class="community-note"><span class="community-note-icon"><i class="fa-solid fa-people-group" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><use href="#icon-people-group"></use></svg></i></span><span><strong><%= typeof siteTagline !== 'undefined' && siteTagline ? siteTagline : 'Serving Our Community' %></strong><span>Barangay Malimba, Gapan City</span></span><i class="fa-solid fa-circle-check" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><use href="#icon-circle-check"></use></svg></i></div>
                </div>
            </div>
        </section>

        <section class="access-strip" aria-label="Portal benefits">
            <div class="page-container access-grid">
                <div class="access-item"><i class="fa-regular fa-calendar-check" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><use href="#icon-calendar-check"></use></svg></i><div><strong>Simpler appointments</strong><span>Plan your next visit online</span></div></div>
                <div class="access-item"><i class="fa-regular fa-bell" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><use href="#icon-bell"></use></svg></i><div><strong>Stay in the loop</strong><span>Community news in one place</span></div></div>
                <div class="access-item"><i class="fa-solid fa-hand-holding-heart" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><use href="#icon-hand-holding-heart"></use></svg></i><div><strong>People-first service</strong><span>Support for every resident</span></div></div>
            </div>
        </section>

        <section class="section services-section" id="services" aria-labelledby="services-title">
            <div class="page-container">
                <div class="section-heading">
                    <div><p class="eyebrow">HERE TO HELP</p><h2 id="services-title">Your barangay services, simplified.</h2><p class="section-description">Less hassle. More connection. Find what you need and take the next step.</p></div>
                    <a href="<%= signedIn ? dashboardUrl : '/users/login' %>" class="text-link" data-open-login>Go to resident portal <i class="fa-solid fa-arrow-right" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><use href="#icon-arrow-right"></use></svg></i></a>
                </div>
                <div class="services-grid">
                    <a class="service-card" href="/users/schedule" data-open-login>
                        <div class="service-top"><span class="service-icon icon-blue"><i class="fa-regular fa-calendar-check" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><use href="#icon-calendar-check"></use></svg></i></span><span class="service-number" aria-hidden="true">01</span></div>
                        <h3>Appointments</h3><p>Request a schedule and manage your upcoming barangay appointments.</p><span class="card-link">Plan your visit <i class="fa-solid fa-arrow-right" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><use href="#icon-arrow-right"></use></svg></i></span>
                    </a>
                    <a class="service-card" href="#announcements">
                        <div class="service-top"><span class="service-icon icon-amber"><i class="fa-solid fa-bullhorn" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><use href="#icon-bullhorn"></use></svg></i></span><span class="service-number" aria-hidden="true">02</span></div>
                        <h3>Announcements</h3><p>Find the latest community news, important advisories, and local events.</p><span class="card-link">See what’s new <i class="fa-solid fa-arrow-right" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><use href="#icon-arrow-right"></use></svg></i></span>
                    </a>
                    <a class="service-card" href="/users/login" data-open-login>
                        <div class="service-top"><span class="service-icon icon-teal"><i class="fa-regular fa-folder-open" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><use href="#icon-folder-open"></use></svg></i></span><span class="service-number" aria-hidden="true">03</span></div>
                        <h3>Resident requests</h3><p>Submit your information and follow the progress of your resident requests.</p><span class="card-link">Make a request <i class="fa-solid fa-arrow-right" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><use href="#icon-arrow-right"></use></svg></i></span>
                    </a>
                    <a class="service-card" href="/users/login" data-open-login>
                        <div class="service-top"><span class="service-icon icon-blue"><i class="fa-regular fa-bell" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><use href="#icon-bell"></use></svg></i></span><span class="service-number" aria-hidden="true">04</span></div>
                        <h3>Notifications</h3><p>Keep track of updates on your requests, appointments, and community activities.</p><span class="card-link">Check your updates <i class="fa-solid fa-arrow-right" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><use href="#icon-arrow-right"></use></svg></i></span>
                    </a>
                    <a class="service-card" href="/about">
                        <div class="service-top"><span class="service-icon icon-teal"><i class="fa-solid fa-people-group" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><use href="#icon-people-group"></use></svg></i></span><span class="service-number" aria-hidden="true">05</span></div>
                        <h3>Our barangay</h3><p>Meet our team and discover the mission behind our community programs.</p><span class="card-link">Get to know us <i class="fa-solid fa-arrow-right" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><use href="#icon-arrow-right"></use></svg></i></span>
                    </a>
                    <a class="service-card" href="/contact">
                        <div class="service-top"><span class="service-icon icon-amber"><i class="fa-regular fa-comments" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><use href="#icon-comments"></use></svg></i></span><span class="service-number" aria-hidden="true">06</span></div>
                        <h3>Help &amp; assistance</h3><p>Have a question or feedback? Our team is here to point you in the right direction.</p><span class="card-link">Let’s talk <i class="fa-solid fa-arrow-right" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><use href="#icon-arrow-right"></use></svg></i></span>
                    </a>
                </div>
            </div>
        </section>

        <section class="section announcements-section" id="announcements" aria-labelledby="announcements-title">
            <div class="page-container">
                <div class="section-heading">
                    <div><p class="eyebrow">THE COMMUNITY BOARD</p><h2 id="announcements-title">What’s happening in Malimba.</h2><p class="section-description">Your source for the latest news and updates from our barangay.</p></div>
                    <a href="/users/announcements" class="text-link" data-open-login>View all announcements <i class="fa-solid fa-arrow-right" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><use href="#icon-arrow-right"></use></svg></i></a>
                </div>
                <div id="announcements-list" class="announcements-grid" data-ssr="<%= announcements.length ? '1' : '0' %>" aria-live="polite">
                    <% if (announcements.length) { %>
                        <% announcements.slice(0, 3).forEach(function(a) { %>
                            <% const type = String(a.type || 'general'); %>
                            <% const typeClass = ['urgent', 'emergency', 'maintenance', 'event'].includes(type) ? 'badge-' + type : 'badge-general'; %>
                            <% const text = String(a.content || '').replace(/<[^>]*>/g, ''); const snippet = text.length > 140 ? text.slice(0, 140) + '…' : text; %>
                            <a class="announce-item" href="/users/announcements" data-open-login data-type="<%= type %>">
                                <div class="thumb">
                                    <% if (a.imageUrl) { %><img src="<%= a.imageUrl %>" alt="" loading="lazy"><% } else { %><i class="fa-solid fa-bullhorn" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><use href="#icon-bullhorn"></use></svg></i><% } %>
                                </div>
                                <div class="content">
                                    <div class="meta"><span class="badge <%= typeClass %>"><%= type %></span>
                                        <% if (a.createdAt && !Number.isNaN(new Date(a.createdAt).getTime())) { %><time class="announcement-date" datetime="<%= new Date(a.createdAt).toISOString() %>"><%= new Date(a.createdAt).toLocaleDateString('en-PH', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'Asia/Manila' }) %></time><% } %>
                                    </div>
                                    <h3 class="title"><%= a.title || 'Community announcement' %></h3><p class="excerpt"><%= snippet %></p><span class="announcement-link">Read announcement <i class="fa-solid fa-arrow-right" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><use href="#icon-arrow-right"></use></svg></i></span>
                                </div>
                            </a>
                        <% }); %>
                    <% } else { %>
                        <div class="announcements-empty"><span class="empty-icon"><i class="fa-solid fa-bullhorn" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><use href="#icon-bullhorn"></use></svg></i></span><h3>You’re all caught up</h3><p>New barangay announcements and advisories will appear here.</p><a href="/users/login" class="text-link" data-open-login>Sign in for your personal updates <i class="fa-solid fa-arrow-right" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><use href="#icon-arrow-right"></use></svg></i></a></div>
                    <% } %>
                </div>
            </div>
        </section>

        <section class="section community-section" aria-labelledby="community-title">
            <div class="page-container community-grid">
                <div class="community-collage">
                    <figure class="community-photo-main"><img src="/images/e.jpg" alt="Barangay Malimba volunteers supporting a local community health initiative" width="1536" height="2048" loading="lazy"><figcaption><i class="fa-solid fa-heart" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><use href="#icon-heart"></use></svg></i> Small actions. Lasting impact.</figcaption></figure>
                    <figure class="community-photo-small"><img src="/images/c.jpg" alt="Community volunteers promoting proper waste disposal in Malimba" width="1536" height="2048" loading="lazy"></figure>
                    <div class="collage-detail" aria-hidden="true"><i class="fa-solid fa-seedling"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><use href="#icon-seedling"></use></svg></i></div>
                </div>
                <div class="community-copy"><p class="eyebrow">ROOTED IN COMMUNITY</p><h2 id="community-title">More than a place.<br>A community that cares.</h2><p>From local health initiatives to a cleaner neighborhood, every effort begins with our people. Together, we’re building a better everyday life in Barangay Malimba.</p><ul class="community-values"><li><i class="fa-solid fa-check" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><use href="#icon-check"></use></svg></i> Accessible services for our residents</li><li><i class="fa-solid fa-check" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><use href="#icon-check"></use></svg></i> A healthier, safer neighborhood</li><li><i class="fa-solid fa-check" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><use href="#icon-check"></use></svg></i> A shared commitment to our future</li></ul><a href="/about" class="button button-outline">Discover our barangay <i class="fa-solid fa-arrow-right" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><use href="#icon-arrow-right"></use></svg></i></a></div>
            </div>
        </section>

        <section class="getting-started-section" aria-labelledby="getting-started-title">
            <div class="page-container">
                <div class="centered-heading"><p class="eyebrow">A FEW SIMPLE STEPS</p><h2 id="getting-started-title">Your community, at your fingertips.</h2><p class="section-description">Getting connected is easy. Here’s how to begin.</p></div>
                <ol class="steps-grid"><li><span class="step-number">01</span><h3>Create your account</h3><p>Register with your details and select your purok.</p></li><li><span class="step-number">02</span><h3>Wait for approval</h3><p>Our barangay team will review your registration.</p></li><li><span class="step-number">03</span><h3>Connect and get things done</h3><p>Sign in to access services and follow your updates.</p></li></ol>
            </div>
        </section>

        <section class="cta-section" aria-labelledby="cta-title">
            <div class="page-container"><div class="cta-panel"><div><p class="eyebrow">LET’S MOVE FORWARD, TOGETHER</p><h2 id="cta-title">A better-connected barangay starts with you.</h2><p>Join the community portal and keep Malimba within reach.</p></div><div class="cta-actions">
                <% if (signedIn) { %><a href="<%= dashboardUrl %>" class="button button-white">Open your portal <i class="fa-solid fa-arrow-right" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><use href="#icon-arrow-right"></use></svg></i></a><% } else if (registrationEnabled) { %><a href="/users/register" class="button button-white" data-open-register>Create an account <i class="fa-solid fa-arrow-right" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><use href="#icon-arrow-right"></use></svg></i></a><% } else { %><a href="/users/login" class="button button-white" data-open-login>Sign in to your account <i class="fa-solid fa-arrow-right" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><use href="#icon-arrow-right"></use></svg></i></a><% } %>
                <a href="/contact" class="cta-help">Need a hand? Contact our team</a>
            </div></div></div>
        </section>
    </main>

    <%- include('partials/public-footer') %>

    <%- include('partials/public-auth') %>
</body>
</html>
