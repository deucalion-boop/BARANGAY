<!DOCTYPE html>
<html lang="en">
<%- include('partials/public-head', { pageTitle: 'Contact us', pageDescription: 'Get in touch with Barangay Malimba. Find our contact details, office hours, and directions, or get help with the community portal.', pageStyles: ['/css/contact.css'], pageScripts: ['/js/contact.js'] }) %>
<body class="landing-page public-page contact-page">
    <% const contactSignedIn = typeof isAuthenticated !== 'undefined' && isAuthenticated === true; %>
    <% const contactDashboardUrl = typeof admin !== 'undefined' && admin ? '/admin/dashboard' : '/users/dashboard'; %>
    <%- include('partials/public-header', { currentPage: 'contact' }) %>

    <main id="main-content" tabindex="-1">
        <section class="page-hero contact-hero" aria-labelledby="contact-title">
            <div class="page-container">
                <nav class="page-breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">Contact us</span></nav>
                <div class="page-hero-grid">
                <div class="page-hero-copy">
                    <p class="eyebrow">WE'RE HERE TO HELP</p>
                    <h1 id="contact-title">A conversation away.<br><span>Here for our community.</span></h1>
                    <p>Have a question about the community portal or need a little guidance? Reach out, find our office, and take your next step with confidence.</p>
                    <div class="hero-actions">
                        <a class="button button-primary" href="tel:+639153511681"><i aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><use href="#icon-phone"></use></svg></i> Call us</a>
                        <a class="button button-outline" href="#visit-us">Plan your visit <i aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><use href="#icon-arrow-right"></use></svg></i></a>
                    </div>
                </div>
                <div class="contact-welcome-panel">
                    <div class="contact-panel-pattern" aria-hidden="true"></div>
                    <img src="/images/logo.png" alt="Barangay Malimba seal" width="112" height="112">
                    <p class="contact-panel-label">YOUR LOCAL CONNECTION</p>
                    <h2>Let's move forward,<br>together.</h2>
                    <p>Barangay Malimba<br>Gapan City, Nueva Ecija</p>
                    <div class="contact-panel-note"><i aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><use href="#icon-people-group"></use></svg></i><span>Serving our people. Supporting our community.</span></div>
                </div>
                </div>
            </div>
        </section>

        <section class="page-section contact-details-section" aria-labelledby="contact-details-title">
            <div class="page-container">
                <div class="page-section-heading">
                    <p class="eyebrow">LET'S GET IN TOUCH</p>
                    <h2 id="contact-details-title">Find the right way to reach us.</h2>
                    <p>For questions or concerns, use the contact details below or visit during office hours.</p>
                </div>
                <div class="contact-details-grid">
                    <article class="contact-detail-card">
                        <span class="contact-detail-icon"><i aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><use href="#icon-phone"></use></svg></i></span>
                        <h3>Give us a call</h3>
                        <a class="contact-value" href="tel:+639153511681">+63 915 351 1681</a>
                        <p>A direct way to ask a question or get guidance.</p>
                        <a class="text-link" href="tel:+639153511681">Call our number <i aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><use href="#icon-arrow-right"></use></svg></i></a>
                    </article>
                    <article class="contact-detail-card">
                        <span class="contact-detail-icon contact-icon-teal"><i aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><use href="#icon-envelope"></use></svg></i></span>
                        <h3>Send an email</h3>
                        <a class="contact-value" href="mailto:sheenkahlie@gmail.com">sheenkahlie@gmail.com</a>
                        <p>Share your questions and concerns with us.</p>
                        <a class="text-link" href="mailto:sheenkahlie@gmail.com">Write to us <i aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><use href="#icon-arrow-right"></use></svg></i></a>
                    </article>
                    <article class="contact-detail-card">
                        <span class="contact-detail-icon"><i aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><use href="#icon-location-dot"></use></svg></i></span>
                        <h3>Visit our office</h3>
                        <p class="contact-value">Barangay Malimba Gapan, City, Nueva Ecija</p>
                        <p>Find our location and plan your route below.</p>
                        <a class="text-link" href="#visit-us">Find us on the map <i aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><use href="#icon-arrow-right"></use></svg></i></a>
                    </article>
                    <article class="contact-detail-card">
                        <span class="contact-detail-icon contact-icon-amber"><i aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><use href="#icon-clock"></use></svg></i></span>
                        <h3>Office hours</h3>
                        <p class="contact-value">Mon-Fri: 9AM-5PM</p>
                        <p>Keep our office hours in mind when planning a visit.</p>
                        <span class="contact-hours-note">Monday to Friday</span>
                    </article>
                </div>
            </div>
        </section>

        <section class="page-section page-muted-section contact-location-section" id="visit-us" aria-labelledby="contact-location-title">
            <div class="page-container contact-location-grid">
                <div class="contact-location-copy">
                    <p class="eyebrow">COME SAY HELLO</p>
                    <h2 id="contact-location-title">Find your way<br> to Malimba.</h2>
                    <p>Use the map to locate our barangay. Open directions to plan a route from your location.</p>
                    <div class="contact-address-block">
                        <span class="contact-address-icon"><i aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><use href="#icon-location-dot"></use></svg></i></span>
                        <div><h3>Our address</h3><address id="contact-address">Barangay Malimba Gapan, City, Nueva Ecija</address></div>
                    </div>
                    <div class="contact-map-actions">
                        <a class="button button-primary" href="https://www.google.com/maps/dir/?api=1&destination=15.2505608,120.9475923" target="_blank" rel="noopener noreferrer">Get directions <i aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><use href="#icon-arrow-right"></use></svg></i></a>
                        <a class="text-link" href="https://www.google.com/maps/search/Barangay+Malimba+Gapan,+City,+Nueva+Ecija/@15.2505608,120.9475923,15z/data=!3m1!4b1?entry=ttu&amp;g_ep=EgoyMDI1MTAyOS4yIKXMDSoASAFQAw%3D%3D" target="_blank" rel="noopener noreferrer">Open Google Maps <i aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><use href="#icon-external-link"></use></svg></i></a>
                    </div>
                    <div class="contact-copy-row"><button class="contact-copy-button" type="button" id="copy-address-btn"><i aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><use href="#icon-copy"></use></svg></i> Copy address</button><span class="contact-copy-status" id="copy-address-status" role="status" aria-live="polite"></span></div>
                </div>
                <div class="contact-map-card">
                    <div class="contact-map-caption"><span class="contact-map-dot" aria-hidden="true"></span><strong>Barangay Malimba</strong><span>Gapan City, Nueva Ecija</span></div>
                    <div class="contact-map-embed">
                        <iframe src="https://www.google.com/maps?q=15.2505608,120.9475923&z=15&output=embed" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen title="Barangay Malimba Gapan, City, Nueva Ecija on Google Maps"></iframe>
                    </div>
                </div>
            </div>
        </section>

        <section class="page-section contact-help-section" aria-labelledby="contact-help-title">
            <div class="page-container">
                <div class="contact-help-panel">
                    <div class="contact-help-copy"><p class="eyebrow">A LITTLE GUIDANCE GOES A LONG WAY</p><h2 id="contact-help-title">Need help with the portal?</h2><p>For account access, appointments, or resident requests, tell us what you're trying to do so we can point you in the right direction.</p></div>
                    <div class="contact-help-actions"><a class="button button-primary" href="<%= contactSignedIn ? contactDashboardUrl : '/users/login' %>" data-open-login><%= contactSignedIn ? 'Open your portal' : 'Sign in to the portal' %> <i aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><use href="#icon-arrow-right"></use></svg></i></a><a class="text-link" href="/users/forgot-password">Forgot your password?</a></div>
                </div>
            </div>
        </section>
    </main>

    <%- include('partials/public-footer') %>
    <%- include('partials/public-auth') %>
</body>
</html>
