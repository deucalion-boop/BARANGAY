            <a href="tel:+639153511681"><i class="fa-solid fa-phone" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><use href="#icon-phone"></use></svg></i> <span>Need assistance?</span> +63 915 351 1681</a>
