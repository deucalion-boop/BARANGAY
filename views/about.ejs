<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>About Us - Community Portal</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        /* About Section */
.about-section {
    margin-bottom: 3.5rem;
    padding: 2rem;
    background: var(--light-bg);
    border-radius: 12px;
    transition: background 0.3s ease;
}

.about-section:last-child {
    margin-bottom: 0;
}

.about-section h3 {
    color: var(--primary-color);
    margin-bottom: 1.25rem;
    font-size: clamp(1.5rem, 4vw, 1.75rem);
    display: flex;
    align-items: center;
    gap: 12px;
    font-weight: 700;
    letter-spacing: -0.02em;
}

.about-section h3 i {
    font-size: 1.3rem;
    color: var(--primary-dark);
}

/* Tech Stack */
.tech-stack {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 1.25rem;
    margin-top: 1.5rem;
    padding: 1rem;
}

.tech-item {
    background: white;
    padding: 1.25rem;
    border-radius: 10px;
    text-align: center;
    box-shadow: var(--shadow-sm);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.tech-item:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-md);
}

.tech-icon {
    font-size: 2.5rem;
    color: var(--primary-color);
    margin-bottom: 0.75rem;
    transition: color 0.3s ease;
}

.tech-item:hover .tech-icon {
    color: var(--primary-dark);
}

.tech-name {
    font-weight: 600;
    color: var(--dark-text);
    font-size: 1rem;
    letter-spacing: 0.02em;
}

/* Team Section */
.team-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2.5rem;
    margin-top: 2.5rem;
    padding: 1rem;
}

.team-member {
    background: white;
    padding: 2.5rem;
    border-radius: 16px;
    text-align: center;
    box-shadow: var(--shadow);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.team-member:hover {
    transform: translateY(-8px);
    box-shadow: var(--shadow-lg);
}

.member-avatar {
    width: 120px;
    height: 120px;
    background: linear-gradient(135deg, var(--primary-color), var(--primary-dark));
    border-radius: 50%;
    margin: 0 auto 1.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-size: 2.5rem;
    font-weight: 500;
    overflow: hidden;
    transition: transform 0.3s ease;
}

.team-member:hover .member-avatar {
    transform: scale(1.05);
}

.member-name {
    color: var(--primary-color);
    margin-bottom: 0.75rem;
    font-size: clamp(1.25rem, 3vw, 1.4rem);
    font-weight: 700;
}

.member-role {
    color: var(--secondary-text);
    font-style: italic;
    margin-bottom: 1.25rem;
    font-size: 0.95rem;
}

/* Enhanced Team Card Layout */
.team-member {
    position: relative;
    border: 1px solid #e9eef5;
    background: linear-gradient(180deg, #ffffff, #fcfdff);
}

.team-member::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(90deg, var(--primary-color), var(--primary-dark));
    opacity: 0.85;
}

.member-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.75rem;
}

.member-info {
    text-align: left;
}

.member-name {
    margin: 0 0 0.35rem 0;
}

.role-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    border: 1px solid transparent;
}

.role-bns {
    color: #4338ca;
    background: rgba(99, 102, 241, 0.12);
    border-color: rgba(99, 102, 241, 0.25);
}

.role-bhw {
    color: #0f766e;
    background: rgba(45, 212, 191, 0.12);
    border-color: rgba(45, 212, 191, 0.25);
}

.member-phone {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    color: var(--secondary-text);
    font-weight: 600;
}

.member-phone .phone-number {
    color: inherit;
    text-decoration: none;
}

/* Removed call/SMS action buttons per request */

/* Image Cards */
.image-cards {
    padding: 2rem 0 3rem;
}

.cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
}

.image-card {
    background: white;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: var(--shadow);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.image-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-lg);
}

.image-card .card-image {
    position: relative;
    padding-top: 56.25%; /* 16:9 */
    overflow: hidden;
}

.image-card .card-image img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.image-card .card-body {
    padding: 1.25rem 1.25rem 1.5rem;
}

.image-card .card-title {
    margin: 0 0 0.5rem 0;
    color: var(--primary-color);
    font-size: clamp(1.1rem, 2.5vw, 1.25rem);
    font-weight: 700;
}

.image-card .card-text {
    margin: 0;
    color: var(--secondary-text);
    line-height: 1.6;
}

/* Section Title (for image card group) */
.section-title {
    color: var(--primary-color);
    margin: 0 0 1rem 0;
    font-size: clamp(1.4rem, 3.5vw, 1.8rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    text-align: center;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
}

/* Landscape Image Card */

/* place landscape card below the two cards within the same section */
.image-cards .landscape-card {
    margin-top: 1.75rem;
}

.landscape-card {
    background: white;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: var(--shadow);
}

.landscape-card .card-image {
    position: relative;
    padding-top: 40%; /* wide landscape */
    overflow: hidden;
}

.landscape-card .card-image img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.landscape-card .card-body {
    padding: 1.25rem 1.5rem 1.75rem;
}

.landscape-card .card-title {
    margin: 0 0 0.5rem 0;
    color: var(--primary-color);
    font-size: clamp(1.1rem, 2.5vw, 1.3rem);
    font-weight: 700;
}

.landscape-card .card-text {
    margin: 0;
    color: var(--secondary-text);
    line-height: 1.7;
}

/* Responsive Design */
@media (max-width: 768px) {
    .about-section {
        padding: 1.5rem;
    }

    .tech-stack {
        grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
        gap: 1rem;
    }

    .team-grid {
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 1.5rem;
    }

    .team-member {
        padding: 1.5rem;
    }

    .member-avatar {
        width: 100px;
        height: 100px;
        font-size: 2rem;
    }
}

@media (max-width: 480px) {
    .about-section h3 {
        font-size: 1.4rem;
        gap: 8px;
    }

    .tech-stack {
        grid-template-columns: 1fr;
    }

    .tech-item {
        padding: 1rem;
    }

    .team-grid {
        grid-template-columns: 1fr;
    }
}
    </style>
