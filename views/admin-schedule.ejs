            function logout() {
                try {
                    if (!confirm('Are you sure you want to logout?')) return;
                    fetch('/admin/logout', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' }
                    })
                    .then(r => r.json())
                    .then(() => { window.location.href = '/'; })
                    .catch(() => { window.location.href = '/'; });
                } catch (error) {
                    console.error('Error in logout:', error);
                }
            }

            function openApproveModal(reqId, start) {
                try {
                    console.log('Attempting to open approve modal, reqId:', reqId, 'start:', start);
                    const approveRequestId = document.getElementById('approveRequestId');
                    const approveReqDate = document.getElementById('approveReqDate');
                    const approveReqTime = document.getElementById('approveReqTime');
                    const modal = document.getElementById('approveRequestModal');

                    if (!modal) {
                        console.error('Approve modal element not found');
                        alert('Error: Approve modal could not be loaded');
                        return;
                    }
                    if (!approveRequestId) {
                        console.error('Approve request ID input not found');
                        alert('Error: Form configuration is incorrect');
                        return;
                    }
                    if (!approveReqDate || !approveReqTime) {
                        console.error('Approve date or time input not found');
                        alert('Error: Form configuration is incorrect');
                        return;
                    }

                    approveRequestId.value = reqId || '';
                    if (start && start.includes('T')) {
                        const [date, time] = start.split('T');
                        approveReqDate.value = date || '';
                        approveReqTime.value = time || '';
                    } else {
                        console.warn('Invalid or missing start time, resetting date and time fields');
                        approveReqDate.value = '';
                        approveReqTime.value = '';
                    }

                    modal.style.display = 'block';
                    console.log('Approve modal opened successfully');
                } catch (error) {
                    console.error('Error in openApproveModal:', error);
                    alert('Failed to open approve modal');
