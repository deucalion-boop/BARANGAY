            // Patient Information Functions
            let allPatients = [];
            
            async function loadPatients() {
                try {
                    console.log('Loading patients...');
                    const response = await fetch('/admin/schedule/patients');
                    if (!response.ok) throw new Error(`HTTP error! status: ${response.status}`);
                    
                    const data = await response.json();
                    if (data.success) {
                        allPatients = data.patients || [];
                        renderPatients(allPatients);
                    } else {
                        console.error('Failed to load patients');
                        showPatientsError('Failed to load patients');
                    }
                } catch (error) {
                    console.error('Error loading patients:', error);
                    showPatientsError('Error loading patients');
                }
            }

            function renderPatients(patients) {
                try {
                    const tbody = document.getElementById('patients-tbody');
                    if (!tbody) {
                        console.error('Patients table body not found');
                        return;
                    }
                    
                    tbody.innerHTML = '';
                    
                    if (patients.length === 0) {
                        tbody.innerHTML = `
                            <tr>
                                <td colspan="7" class="empty-state">
                                    <i class="fas fa-user-slash"></i>
                                    <p>No patients found</p>
                                </td>
                            </tr>
                        `;
                        return;
                    }
                    
                    patients.forEach(patient => {
                        const row = document.createElement('tr');
                        row.setAttribute('data-patient-id', patient._id); // Add patient ID to row
                        const fullName = `${patient.firstName || ''} ${patient.lastName || ''}`.trim() || 'Unknown';
                        const email = patient.email || 'N/A';
                        const phone = patient.phone || 'N/A';
                        const purok = patient.unitNumber ? `Purok ${patient.unitNumber}` : 'N/A';
                        const totalAppts = patient.appointmentCount || 0;
                        
                        let lastApptDate = 'Never';
                        let lastApptStatus = '';
                        if (patient.lastAppointment) {
                            const date = new Date(patient.lastAppointment.appointmentDate);
                            lastApptDate = date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
                            lastApptStatus = patient.lastAppointment.status || '';
                        }
                        
                        // Determine status based on last appointment
                        let statusClass = 'status-scheduled';
                        let statusText = 'Scheduled';
                        
                        if (patient.lastAppointment) {
                            if (patient.lastAppointment.status === 'completed') {
                                statusClass = 'status-completed';
                                statusText = 'Completed';
                            } else {
                                statusClass = 'status-scheduled';
                                statusText = 'Scheduled';
                            }
                        } else {
                            statusClass = 'status-no-show';
                            statusText = 'No Appointments';
                        }
                        
                        row.innerHTML = `
                            <td>
                                <strong>${fullName}</strong><br>
                                <small style="color: #64748b;">${email}</small>
                            </td>
                            <td>
                                <div style="display: flex; flex-direction: column; gap: 0.25rem;">
                                    <small><i class="fas fa-phone" style="color: #64748b;"></i> ${phone}</small>
                                </div>
                            </td>
                            <td>${purok}</td>
                            <td>
                                <span style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.25rem 0.75rem; background: #f0f9ff; border-radius: 12px; font-weight: 600; color: #0369a1;">
                                    ${totalAppts}
                                </span>
                            </td>
                            <td>
                                ${lastApptDate}<br>
                                ${lastApptStatus ? `<small><span class="status-badge status-${lastApptStatus}">${lastApptStatus}</span></small>` : ''}
                            </td>
                            <td><span class="status-badge ${statusClass}">${statusText}</span></td>
                            <td>
                                <div class="action-buttons">
                                    <button class="btn btn-sm btn-primary view-patient-history-btn" data-patient-id="${patient._id}" title="View History">
                                        <i class="fas fa-history"></i>
                                    </button>
                                    ${patient.lastAppointment && patient.lastAppointment.status !== 'completed' ? `
                                    <button class="btn btn-sm btn-success complete-appointment-btn" data-appointment-id="${patient.lastAppointment._id}" title="Complete">
                                        <i class="fas fa-check"></i>
                                    </button>
                                    ` : ''}
                                </div>
                            </td>
                        `;
                        tbody.appendChild(row);
                    });
                    
                    // Enhance action buttons
                    enhanceActionButtons(tbody);
                } catch (error) {
                    console.error('Error rendering patients:', error);
                }
            }

            function showPatientsError(message) {
                const tbody = document.getElementById('patients-tbody');
                if (tbody) {
                    tbody.innerHTML = `
                        <tr>
                            <td colspan="7" style="text-align: center; padding: 2rem; color: #ef4444;">
                                <i class="fas fa-exclamation-triangle"></i> ${message}
                            </td>
                        </tr>
                    `;
                }
            }

            function filterPatients(searchTerm) {
                if (!searchTerm) {
                    renderPatients(allPatients);
                    return;
                }
                
                const filtered = allPatients.filter(patient => {
                    const fullName = `${patient.firstName || ''} ${patient.lastName || ''}`.toLowerCase();
                    const email = (patient.email || '').toLowerCase();
                    const phone = (patient.phone || '').toLowerCase();
                    const search = searchTerm.toLowerCase();
                    
                    return fullName.includes(search) || email.includes(search) || phone.includes(search);
                });
                
                renderPatients(filtered);
            }

            async function viewPatientHistory(patientId) {
                try {
                    console.log('Viewing patient history:', patientId);
                    const response = await fetch(`/admin/schedule/patients/${patientId}/appointments`);
                    if (!response.ok) throw new Error(`HTTP error! status: ${response.status}`);
                    
                    const data = await response.json();
                    if (data.success) {
                        const patient = data.patient;
                        const appointments = data.appointments || [];
                        
                        let appointmentsList = '';
                        if (appointments.length > 0) {
                            appointmentsList = `
                                <div style="margin-top: 1.5rem;">
                                    <h4 style="color: var(--primary-dark); margin-bottom: 1rem;">
                                        <i class="fas fa-calendar-alt"></i> Appointment History (${appointments.length})
                                    </h4>
                                    <div style="max-height: 300px; overflow-y: auto;">
                                        <table style="width: 100%; font-size: 0.875rem;">
                                            <thead>
                                                <tr style="background: var(--light-bg);">
                                                    <th style="padding: 0.5rem; text-align: left;">Date</th>
                                                    <th style="padding: 0.5rem; text-align: left;">Type</th>
                                                    <th style="padding: 0.5rem; text-align: left;">Status</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                ${appointments.map(apt => `
                                                    <tr style="border-bottom: 1px solid #e2e8f0;">
                                                        <td style="padding: 0.5rem;">${new Date(apt.appointmentDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</td>
                                                        <td style="padding: 0.5rem;">${apt.appointmentType || 'N/A'}</td>
                                                        <td style="padding: 0.5rem;"><span class="status-badge status-${apt.status}">${apt.status}</span></td>
                                                    </tr>
                                                `).join('')}
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            `;
                        }
                        
                        const detailsDiv = document.getElementById('appointmentDetails');
                        if (detailsDiv) {
                            detailsDiv.innerHTML = `
                                <div style="padding: 1.5rem;">
                                    <h4 style="color: var(--primary-dark); margin-bottom: 1rem;">
                                        <i class="fas fa-user"></i> Patient Information
                                    </h4>
                                    <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; margin-bottom: 1rem;">
                                        <div>
                                            <strong style="color: var(--text-light);">Full Name:</strong><br>
                                            <span style="color: var(--text-dark);">${patient.firstName || ''} ${patient.lastName || ''}</span>
                                        </div>
                                        <div>
                                            <strong style="color: var(--text-light);">Email:</strong><br>
                                            <span style="color: var(--text-dark);">${patient.email || 'N/A'}</span>
                                        </div>
                                        <div>
                                            <strong style="color: var(--text-light);">Phone:</strong><br>
                                            <span style="color: var(--text-dark);">${patient.phone || 'N/A'}</span>
                                        </div>
                                        <div>
                                            <strong style="color: var(--text-light);">Purok:</strong><br>
                                            <span style="color: var(--text-dark);">${patient.unitNumber ? `Purok ${patient.unitNumber}` : 'N/A'}</span>
                                        </div>
                                        <div>
                                            <strong style="color: var(--text-light);">Total Appointments:</strong><br>
                                            <span style="color: var(--text-dark);">${appointments.length}</span>
                                        </div>
                                        <div>
                                            <strong style="color: var(--text-light);">Status:</strong><br>
                                            <span class="status-badge ${patient.isActive ? 'status-completed' : 'status-no-show'}">${patient.isActive ? 'Active' : 'Inactive'}</span>
                                        </div>
                                    </div>
                                    ${appointmentsList}
                                </div>
                            `;
                            
                            const modal = document.getElementById('detailsModal');
                            if (modal) {
                                modal.style.display = 'block';
                            }
                        }
                    } else {
                        console.error('Failed to load patient history');
                        alert('Failed to load patient history');
                    }
                } catch (error) {
                    console.error('Error viewing patient history:', error);
                    alert('Failed to load patient history');
                }
            }

            // Function to scroll to and highlight a patient in the patient table
            function scrollToPatient(patientId) {
                try {
                    console.log('Scrolling to patient:', patientId);
                    
                    // Find the patient table section
                    const patientsSection = document.querySelector('.pending-requests-section:has(#patients-table)');
                    if (!patientsSection) {
                        console.error('Patients section not found');
                        return;
                    }

                    // Find the patient row
                    const patientRow = document.querySelector(`tr[data-patient-id="${patientId}"]`);
                    if (!patientRow) {
                        console.warn('Patient row not found, reloading patients...');
                        // Reload patients and try again after a short delay
                        loadPatients().then(() => {
                            setTimeout(() => {
                                const row = document.querySelector(`tr[data-patient-id="${patientId}"]`);
                                if (row) {
                                    scrollToAndHighlightRow(row, patientsSection);
                                }
                            }, 500);
                        });
                        return;
                    }

                    scrollToAndHighlightRow(patientRow, patientsSection);
                } catch (error) {
                    console.error('Error scrolling to patient:', error);
                }
            }

            function scrollToAndHighlightRow(row, section) {
                // Scroll to the section first
                section.scrollIntoView({ behavior: 'smooth', block: 'start' });

                // Wait for scroll to complete, then highlight the row
                setTimeout(() => {
                    // Remove highlight from any previously highlighted rows
                    document.querySelectorAll('tr.highlight-patient').forEach(r => {
                        r.classList.remove('highlight-patient');
                    });

                    // Add highlight to the target row
                    row.classList.add('highlight-patient');
                    
                    // Scroll the row into view within its container
                    row.scrollIntoView({ behavior: 'smooth', block: 'center' });

                    // Remove highlight after animation completes
                    setTimeout(() => {
                        row.classList.remove('highlight-patient');
                    }, 2500);
                }, 300);
            }

            // Initialize the app
            initApp();
        }

        // Start the app
        document.addEventListener('DOMContentLoaded', () => {
            console.log('DOM fully loaded, initializing app...');
            initializeApp();
        });

        window.addEventListener('error', function(e) {
            console.error('Global error caught:', e.error);
        });
    </script>
</body>
</html>