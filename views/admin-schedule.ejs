                </div>
                <div class="form-group">
                    <label for="approveReqNotes"><i class="fas fa-sticky-note"></i> Additional Notes (Optional)</label>
                    <textarea id="approveReqNotes" name="notes" placeholder="Add any additional notes..." rows="3"></textarea>
                </div>
                <div class="modal-actions">
                    <button type="button" class="btn btn-secondary cancel-btn">
                        <i class="fas fa-times"></i> Cancel
                    </button>
                    <button type="submit" class="btn btn-success">
                        <i class="fas fa-check"></i> Approve & Schedule
                    </button>
