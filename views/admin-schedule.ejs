                    <label for="customReason"><i class="fas fa-comment"></i> Please specify</label>
                    <input type="text" id="customReason" name="customReason" placeholder="Enter reason...">
                </div>
                <div class="form-group">
                    <label for="declineNotes"><i class="fas fa-sticky-note"></i> Additional Comments & Suggestions</label>
                    <textarea id="declineNotes" name="notes" placeholder="Please provide any additional details, suggest alternative times, or explain what would work better for rescheduling..." rows="4"></textarea>
                </div>
                <div class="form-group">
                    <label><i class="fas fa-info-circle"></i> What happens next?</label>
