                        <p style="margin: 0 0 0.5rem 0;"><strong>Reschedule Process:</strong></p>
                        <ul style="margin: 0; padding-left: 1.2rem;">
                            <li>The resident will receive a notification about the reschedule request</li>
                            <li>They can provide new preferred dates through their dashboard</li>
                            <li>You'll review their new request and approve/decline accordingly</li>
                        </ul>
                    </div>
                </div>
                <div class="modal-actions">
                    <button type="button" class="btn btn-secondary cancel-btn">
                        <i class="fas fa-times"></i> Cancel
                    </button>
                    <button type="submit" class="btn btn-warning">
                        <i class="fas fa-redo"></i> Submit Reschedule Request
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div id="detailsModal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h3><i class="fas fa-info-circle"></i> Appointment Details</h3>
                <span class="close-modal">&times;</span>
            </div>
            <div id="appointmentDetails" class="modal-form">
            </div>
        </div>
    </div>

    <!-- Approve existing appointment (confirmation) -->
    <div id="approveAppointmentModal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h3><i class="fas fa-check-circle"></i> Approve Appointment</h3>
                <span class="close-modal">&times;</span>
            </div>
            <form id="approveAppointmentForm" class="modal-form">
                <input type="hidden" id="approveAppointmentId" name="appointmentId">
                <div class="form-group">
                    <p style="margin:0; color: var(--text-dark);">
                        This will mark the appointment as <strong>scheduled</strong>.
                    </p>
                    <small style="color: var(--text-light); display:block; margin-top: 0.5rem;">
                        You can view full details from the calendar or patient history.
                    </small>
                </div>
                <div class="modal-actions">
                    <button type="button" class="btn btn-secondary cancel-btn">
                        <i class="fas fa-times"></i> Cancel
                    </button>
                    <button type="submit" class="btn btn-success">
                        <i class="fas fa-check"></i> Approve
