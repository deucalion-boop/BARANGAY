            async function handleApproveSubmit(e) {
                e.preventDefault();
                try {
                    console.log('Handling approve submit...');
                    const form = e.target;
                    const formData = new FormData(form);
                    const requestId = formData.get('requestId');
                    const date = formData.get('date');
                    const time = formData.get('time');
                    const doctorId = formData.get('doctorId');
                    const notes = formData.get('notes');

                    console.log('Approve request data:', { requestId, date, time, doctorId, notes });

                    // Determine if this is a reschedule approval or regular approval
                    const isReschedule = document.querySelector('.modal-header h3').textContent.includes('Reschedule');
                    const endpoint = isReschedule ? 
                        `/admin/requests/schedule/${requestId}/approve-reschedule` : 
                        `/admin/requests/schedule/${requestId}/approve`;
                    
                    const response = await fetch(endpoint, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ date, time, doctorId, notes })
                    });
                    const data = await response.json();
                    if (data.success) {
                        alert('Request approved successfully!');
                        closeAllModals();
                        refreshAppointments(); // Refresh appointments after approval
                        
                        // Scroll to patient in patient information table
                        if (data.appointment && data.appointment.patientId) {
                            const patientId = typeof data.appointment.patientId === 'object' 
                                ? data.appointment.patientId._id 
                                : data.appointment.patientId;
                            
                            // Wait a bit for the page to update, then scroll
                            setTimeout(() => {
                                scrollToPatient(patientId);
                            }, 500);
                        }
                        
                        // Remove the request row from pending requests
                        const row = document.querySelector(`button[data-req-id="${requestId}"]`).closest('tr');
                        if (row) {
                            row.remove();
                            // Update pending count
                            const pendingEl = document.getElementById('pending-appointments');
                            if (pendingEl) {
                                const currentCount = parseInt(pendingEl.textContent) || 0;
                                pendingEl.textContent = Math.max(0, currentCount - 1);
                            }
                        }
                    } else {
                        console.error('Approve request failed:', data.error);
                        alert('Error: ' + (data.error || 'Unknown error occurred'));
                    }
                } catch (error) {
                    console.error('Error in handleApproveSubmit:', error);
                    alert('Failed to approve request');
                }
            }

