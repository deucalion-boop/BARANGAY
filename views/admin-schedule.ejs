            </form>
        </div>
    </div>

    <div id="declineRequestModal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h3><i class="fas fa-times-circle"></i> Reschedule Request</h3>
                <span class="close-modal">&times;</span>
            </div>
            <form id="declineRequestForm" class="modal-form">
                <input type="hidden" id="declineRequestId" name="requestId">
                <div class="form-group">
                    <label for="declineReason"><i class="fas fa-exclamation-triangle"></i> Reason for Rescheduling *</label>
                    <select id="declineReason" name="reason" required>
                        <option value="">Select a reason...</option>
                        <option value="schedule_conflict">Schedule Conflict</option>
                        <option value="unavailable">Temporarily Unavailable</option>
                        <option value="requires_adjustment">Requires Time Adjustment</option>
                        <option value="doctor_unavailable">Doctor Unavailable</option>
                        <option value="facility_issue">Facility Issue</option>
