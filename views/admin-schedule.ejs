    <script src="/js/admin.js"></script>
    <script id="server-data" type="application/json"><%- JSON.stringify({ appointments: appointments || [], requests: requests || [], doctors: doctors || [], appointmentTypes: appointmentTypes || [] }) %></script>
    <script>
        // Parse server data from JSON script element
        const serverDataEl = document.getElementById('server-data');
        const serverData = serverDataEl ? JSON.parse(serverDataEl.textContent || '{}') : { appointments: [], requests: [], doctors: [], appointmentTypes: [] };

        function initializeApp() {
            let allAppointments = serverData.appointments || [];
            const pendingRequests = serverData.requests || [];
            const adminDoctors = serverData.doctors || [];

            // Make action buttons icon-only and add hover tooltips
            function enhanceActionButtons(scope) {
                try {
                    const root = scope || document;
                    const mappings = [
                        { selector: '.approve-appointment-btn, .approve-btn', label: 'Approve' },
                        { selector: '.decline-btn', label: 'Reschedule' },
                        { selector: '.approve-reschedule-btn', label: 'Approve New Time' },
                        { selector: '.reject-reschedule-btn', label: 'Reject' },
                        { selector: '.complete-appointment-btn', label: 'Complete' },
                        { selector: '.view-details-btn', label: 'Details' }
                    ];
                    mappings.forEach(({ selector, label }) => {
                        root.querySelectorAll(selector).forEach(btn => {
                            if (!btn.getAttribute('data-label')) btn.setAttribute('data-label', label);
                            if (!btn.getAttribute('title')) btn.setAttribute('title', label);
                            if (!btn.getAttribute('aria-label')) btn.setAttribute('aria-label', label);
                        });
                    });
                } catch (e) {
                    console.warn('enhanceActionButtons failed:', e);
                }
            }

            function initApp() {
                try {
                    console.log('Initializing app...');
                    calculateAndDisplayStatistics();
                    initializeCalendar();
                    // Ensure any existing action buttons (including pending requests) have labels
                    enhanceActionButtons();
                    setupEventListeners();
                    loadStatistics();
                    initModals();
                    loadPatients(); // Load patient information
                } catch (error) {
                    console.error('Error initializing app:', error);
                }
            }

            function initModals() {
                try {
                    document.querySelectorAll('.close-modal, .cancel-btn').forEach(btn => {
                        btn.addEventListener('click', () => {
                            console.log('Close/Cancel button clicked');
                            closeAllModals();
                        });
                    });

                    document.querySelectorAll('.modal').forEach(modal => {
                        modal.addEventListener('click', (e) => {
                            if (e.target === modal) {
                                console.log('Modal background clicked');
                                closeAllModals();
                            }
                        });
                    });

                    const approveForm = document.getElementById('approveRequestForm');
                    if (approveForm) {
                        approveForm.addEventListener('submit', (e) => {
                            console.log('Approve form submitted');
                            handleApproveSubmit(e);
                        });
                    } else {
                        console.warn('Approve form not found');
                    }

                    const declineForm = document.getElementById('declineRequestForm');
                    if (declineForm) {
                        declineForm.addEventListener('submit', (e) => {
                            console.log('Decline form submitted');
                            handleDeclineSubmit(e);
                        });
                    } else {
                        console.warn('Decline form not found');
                    }

                    // Approve existing appointment modal form
                    const approveAppointmentForm = document.getElementById('approveAppointmentForm');
                    if (approveAppointmentForm) {
                        approveAppointmentForm.addEventListener('submit', (e) => {
                            console.log('Approve appointment (modal) form submitted');
                            handleApproveAppointmentSubmit(e);
                        });
                    }

                    const declineReason = document.getElementById('declineReason');
                    if (declineReason) {
                        declineReason.addEventListener('change', function() {
                            console.log('Decline reason changed:', this.value);
                            const otherGroup = document.getElementById('otherReasonGroup');
                            if (otherGroup) {
                                otherGroup.style.display = this.value === 'other' ? 'block' : 'none';
                            }
                        });
                    }

                    // Reschedule appointment flow removed per request
                } catch (error) {
                    console.error('Error initializing modals:', error);
                }
            }

            function closeAllModals() {
                document.querySelectorAll('.modal').forEach(modal => {
                    modal.style.display = 'none';
                });
            }

            function calculateAndDisplayStatistics() {
                try {
                    const total = allAppointments.length;
                    const pending = allAppointments.filter(apt => apt.status === 'pending').length;
                    const completed = allAppointments.filter(apt => apt.status === 'completed').length;
                    const scheduled = allAppointments.filter(apt => apt.status === 'scheduled').length;
                    const pendingRequestsCount = pendingRequests.length;
                    
                    document.getElementById('total-appointments').textContent = total;
                    document.getElementById('pending-appointments').textContent = pending + pendingRequestsCount;
                    document.getElementById('completed-appointments').textContent = completed;
                    document.getElementById('scheduled-appointments').textContent = scheduled;
                } catch (error) {
                    console.error('Error in calculateAndDisplayStatistics:', error);
                }
            }

            async function loadStatistics() {
                try {
                    const response = await fetch('/admin/schedule/statistics');
                    if (!response.ok) throw new Error(`HTTP error! status: ${response.status}`);
                    
                    const data = await response.json();
                    
                    if (data.success) {
                        const stats = data.statistics;
                        document.getElementById('total-appointments').textContent = stats.total || 0;
                        document.getElementById('pending-appointments').textContent = stats.pending || 0;
                        document.getElementById('completed-appointments').textContent = stats.completed || 0;
                        document.getElementById('scheduled-appointments').textContent = stats.scheduled || 0;
                    } else {
                        console.warn('Statistics fetch failed, using local data');
                        calculateAndDisplayStatistics();
                    }
                } catch (error) {
                    console.error('Error loading statistics:', error);
                    calculateAndDisplayStatistics();
                }
            }

            async function refreshAppointments() {
                try {
                    console.log('Refreshing appointments...');
                    const response = await fetch('/admin/schedule/appointments');
                    if (!response.ok) throw new Error(`HTTP error! status: ${response.status}`);

                    const data = await response.json();
                    if (data.success) {
                        allAppointments = data.appointments;
                        refreshCalendar();
                        loadStatistics(); // Also refresh stats
                    } else {
                        console.warn('Failed to refresh appointments');
                    }
                } catch (error) {
                    console.error('Error refreshing appointments:', error);
                }
            }

            // renderAppointments function removed - now using calendar view

            let calendar = null;

            function initializeCalendar() {
                try {
                    const calendarEl = document.getElementById('calendar');
                    if (!calendarEl) {
                        console.error('Calendar element not found');
                        return;
                    }

                    calendar = new FullCalendar.Calendar(calendarEl, {
                        initialView: 'dayGridMonth',
                        headerToolbar: {
                            left: 'prev,next today',
                            center: 'title',
                            right: 'dayGridMonth,timeGridWeek,timeGridDay,listWeek'
                        },
                        height: 'auto',
                        events: allAppointments.map(apt => {
                            const patientName = apt.patientId?.firstName && apt.patientId?.lastName 
                                ? `${apt.patientId.firstName} ${apt.patientId.lastName}` 
                                : apt.patientName || 'Patient';
                            
                            return {
                                id: apt._id,
                                title: `${patientName} - ${apt.appointmentType || 'Appointment'}`,
                                start: `${apt.appointmentDate}T${apt.appointmentTime}`,
                                extendedProps: {
                                    status: apt.status,
                                    type: apt.appointmentType,
                                    patientId: apt.patientId,
                                    notes: apt.notes
                                },
                                backgroundColor: getStatusColor(apt.status),
                                borderColor: getStatusColor(apt.status)
                            };
                        }),
                        eventClick: function(info) {
                            console.log('Calendar event clicked:', info.event.id);
                            viewDetails(info.event.id);
                        },
                        eventDidMount: function(info) {
                            // Add tooltip showing status
                            info.el.title = `${info.event.title}\nStatus: ${info.event.extendedProps.status}`;
                        }
                    });
                    
                    calendar.render();
                    console.log('Calendar initialized successfully');
                } catch (error) {
                    console.error('Error in initializeCalendar:', error);
                }
            }

            function refreshCalendar() {
                if (calendar) {
                    try {
                        // Remove all events
                        calendar.removeAllEvents();
                        
                        // Add updated events
                        const events = allAppointments.map(apt => {
                            const patientName = apt.patientId?.firstName && apt.patientId?.lastName 
                                ? `${apt.patientId.firstName} ${apt.patientId.lastName}` 
                                : apt.patientName || 'Patient';
                            
                            return {
                                id: apt._id,
                                title: `${patientName} - ${apt.appointmentType || 'Appointment'}`,
                                start: `${apt.appointmentDate}T${apt.appointmentTime}`,
                                extendedProps: {
                                    status: apt.status,
                                    type: apt.appointmentType,
                                    patientId: apt.patientId,
                                    notes: apt.notes
                                },
                                backgroundColor: getStatusColor(apt.status),
                                borderColor: getStatusColor(apt.status)
                            };
                        });
                        
                        calendar.addEventSource(events);
                    } catch (error) {
                        console.error('Error refreshing calendar:', error);
                    }
                }
            }

            function getStatusColor(status) {
                const colors = {
                    pending: '#ed8936',
                    scheduled: '#4299e1',
                    completed: '#48bb78',
                    cancelled: '#f56565',
                    'no-show': '#a0aec0'
                };
                return colors[status] || '#4299e1';
            }

            function setupEventListeners() {
                try {
                    // Tab buttons removed - now using calendar only

                    // Logout button
                    const logoutBtn = document.getElementById('logout-btn');
                    if (logoutBtn) {
                        logoutBtn.addEventListener('click', () => {
                            console.log('Logout button clicked');
                            logout();
                        });
                    } else {
                        console.warn('Logout button not found');
                    }

                    // Event delegation for dynamically generated buttons
                    document.addEventListener('click', function(e) {
                        const approveBtn = e.target.closest('.approve-btn');
                        if (approveBtn) {
                            const reqId = approveBtn.dataset.reqId;
                            const start = approveBtn.dataset.start;
                            console.log('Approve button clicked, reqId:', reqId, 'start:', start);
                            if (reqId) {
                                openApproveModal(reqId, start);
                            } else {
                                console.error('Approve button missing data-req-id');
                                alert('Error: Request ID is missing');
                            }
                            return;
                        }

                        const declineBtn = e.target.closest('.decline-btn');
                        if (declineBtn) {
                            const reqId = declineBtn.dataset.reqId;
                            console.log('Decline button clicked, reqId:', reqId);
                            if (reqId) {
                                openDeclineModal(reqId);
                            } else {
                                console.error('Decline button missing data-req-id');
                                alert('Error: Request ID is missing');
                            }
                            return;
                        }

                        const viewDetailsBtn = e.target.closest('.view-details-btn');
                        if (viewDetailsBtn && viewDetailsBtn.dataset.appointmentId) {
                            console.log('View Details button clicked, appointmentId:', viewDetailsBtn.dataset.appointmentId);
                            viewDetails(viewDetailsBtn.dataset.appointmentId);
                            return;
                        }

                        const approveAppointmentBtn = e.target.closest('.approve-appointment-btn');
                        if (approveAppointmentBtn && approveAppointmentBtn.dataset.appointmentId) {
                            console.log('Approve Appointment button clicked, appointmentId:', approveAppointmentBtn.dataset.appointmentId);
                            openApproveAppointmentModal(approveAppointmentBtn.dataset.appointmentId);
                            return;
                        }

                        

                        const completeAppointmentBtn = e.target.closest('.complete-appointment-btn');
                        if (completeAppointmentBtn && completeAppointmentBtn.dataset.appointmentId) {
                            console.log('Complete Appointment button clicked, appointmentId:', completeAppointmentBtn.dataset.appointmentId);
                            updateStatus(completeAppointmentBtn.dataset.appointmentId, 'completed');
                            return;
                        }

                        const approveRescheduleBtn = e.target.closest('.approve-reschedule-btn');
                        if (approveRescheduleBtn && approveRescheduleBtn.dataset.reqId) {
                            console.log('Approve Reschedule button clicked, reqId:', approveRescheduleBtn.dataset.reqId);
                            const newStart = approveRescheduleBtn.dataset.newStart;
                            const newEnd = approveRescheduleBtn.dataset.newEnd;
                            const type = approveRescheduleBtn.dataset.type;
                            openApproveRescheduleModal(approveRescheduleBtn.dataset.reqId, newStart, newEnd, type);
                            return;
                        }

                        const rejectRescheduleBtn = e.target.closest('.reject-reschedule-btn');
                        if (rejectRescheduleBtn && rejectRescheduleBtn.dataset.reqId) {
                            console.log('Reject Reschedule button clicked, reqId:', rejectRescheduleBtn.dataset.reqId);
                            if (confirm('Are you sure you want to reject this reschedule request?')) {
                                rejectRescheduleRequest(rejectRescheduleBtn.dataset.reqId);
                            }
                            return;
                        }

                        // Patient history button
                        const viewPatientHistoryBtn = e.target.closest('.view-patient-history-btn');
                        if (viewPatientHistoryBtn && viewPatientHistoryBtn.dataset.patientId) {
                            console.log('View Patient History button clicked, patientId:', viewPatientHistoryBtn.dataset.patientId);
                            viewPatientHistory(viewPatientHistoryBtn.dataset.patientId);
                            return;
                        }
                    });

                    // Patient search functionality
                    const patientSearch = document.getElementById('patient-search');
                    if (patientSearch) {
                        patientSearch.addEventListener('input', (e) => {
                            filterPatients(e.target.value);
                        });
                    }

                    // Refresh patients button
                    const refreshPatientsBtn = document.getElementById('refresh-patients-btn');
                    if (refreshPatientsBtn) {
                        refreshPatientsBtn.addEventListener('click', () => {
                            console.log('Refresh patients button clicked');
                            loadPatients();
                        });
                    }
                } catch (error) {
                    console.error('Error in setupEventListeners:', error);
                }
            }

